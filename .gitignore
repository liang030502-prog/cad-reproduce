jobs/
*.dxf
*.dwg
*.pdf
!references/*.pdf

# AutoCAD / pipeline scratch
plot.log
*.scr.log
_audit.scr
_export.scr
_convert.scr

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
